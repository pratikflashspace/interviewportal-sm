# Export these into the local shell; this app does NOT automatically load .env.
# Enter real credentials only in Render Environment settings, never in GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REQUIRE_DATABASE_URL=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_TTS_SPEAKER=luna
CLICKUP_API_TOKEN=
CLICKUP_FOLDER_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_AI_CALLS_PER_DAY=100
# Local only; OMIT this on Render unless setting a verified custom domain:
# APP_ORIGIN=http://localhost:8000
